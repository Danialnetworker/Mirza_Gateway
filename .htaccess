<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{DOCUMENT_ROOT}/install/index.php -f
    RewriteCond %{REQUEST_URI} !^/install/
    RewriteRule ^ - [F,L]
</IfModule>

<Files "*.txt">
    Require all denied
</Files>
<Files "error_log">
    Require all denied
</Files>
<Files "*.sh">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
</IfModule>
<Files "*.json">
    Require all denied
</Files>
<Files "*.sql">
    Require all denied
</Files>
<Files "*.zip">
    Require all denied
</Files>
# Backup artefacts: the archiver has used .zip and, since upstream 0.5.1, a
# PharData .tar.gz fallback. Deny the whole family by extension so a leftover
# archive from any build -- including one already sitting on a live host --
# is never served.
<FilesMatch "\.(tar|gz|tgz|bz2|xz|7z|rar)$">
    Require all denied
</FilesMatch>

Options -Indexes

<FilesMatch "^error_log$|\.log$|\.log\.[0-9]+$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
